%% Cutoff Frequency
clc; clear all; close all
S1 = load('test1.s2p');
freq = S1(:,1);
test1_s21_db = S1(:,4);                       % test1, dB format

a = 22.86*10^-3;
b = 10.16*10^-3;

fc_theory = 3*10^8/(2*a); %Theoretical Cutoff Frequency for TE10

figure; 
plot(freq/1e9, test1_s21_db); 
hold on 
grid on
xlabel('Frequency (GHz)'); ylabel('|S21| (dB)');
xline(fc_theory/1e9, '--k', 'theory 6.56 GHz');

[x, ~] = ginput(1);                   % click 
[~, i] = min(abs(freq/1e9 - x));      % nearest data point
fc_meas = freq(i);
xline(fc_meas/1e9, 'r', sprintf('f_c = %.3f GHz', fc_meas/1e9));
fprintf('f = %.3f GHz, S21 = %.2f dB\n', fc_meas/1e9, test1_s21_db(i));
fprintf('error vs theory = %+.2f %%\n', (fc_meas-fc_theory)/fc_theory*100);

%% Phase Constant
clc; clear all; close all
S1 = load('test1.s2p');
S2 = load('test2.s2p');
freq      = S1(:,1);                      % Hz
S21_phasea = S1(:,5)*pi/180;    % radians, already unwrapped to [-pi, pi]
S21_phaseb = S2(:,5)*pi/180;    % radians
w = 2*pi.*freq;
s21_phase = unwrap(S21_phasea-S21_phaseb);


L = 152*10^-3;
a = 22.86*10^-3;
b = 10.16*10^-3;
m= 1;
n=0;

fc_theory = 3*10^8/(2*a); %Theoretical Cutoff Frequency for TE10
wc_theory = fc_theory*2*pi;

%Operating Frequency is above cutoff frequency
idx = freq >= fc_theory;
idy = w >= wc_theory;
f = freq(idx);
w_operating = w(idy);

%Now have a range of w values, we can calculate our theoretical Beta value
%for differing values of w

beta_operating = sqrt(((w_operating./(3*10^8)).^2-(m*pi/a)^2-(n*pi/b)^2));

%We can also apply this to our phase
ph = s21_phase(idx);

[~,k] = min(abs(f - 10e9));                 % fix the 2*pi offset at 10 GHz
n = round((beta_operating(k)*L + ph(k))/(2*pi));
beta_measured = (-ph + 2*pi*n)/L;                  % measured: phase = -beta*L


%Plotting
figure; plot(beta_operating, w_operating, beta_measured, w_operating); grid on
legend('theory','measured')
xlabel('\beta (rad/m)'); ylabel('\omega (rad/s)')

err = mean(abs(beta_measured - beta_operating)./beta_operating)*100;
fprintf('mean beta error = %.2f %%\n', err);

m = f > 8e9;
err8  = mean(abs(beta_measured(m) - beta_operating(m))./beta_operating(m))*100;
ratio = mean(beta_measured(m)./beta_operating(m));
fprintf('error above 8 GHz = %.2f %%, mean ratio = %.3f\n', err8, ratio);


%% Attenuation Constant
clc, close all, clear all

S1 = load('test1.s2p');
S2 = load('test2.s2p');
test1_s21_db = S1(:,4);
test2_s21_db = S2(:,4);
S21_db = test1_s21_db-test2_s21_db;
freq = S1(:,1); 
w = freq*2*pi;
a = 22.86*10^-3;
b = 10.16*10^-3;
L = 152*10^-3;
c = 3*10^8;
m= 1;
n=0;
permeability_free_space = 4*pi*10^-7;
conductivity = 3.816*10^7;


%Attenuation Constant value from pre-lab
f_prelab = 7*10^9;
w_prelab = f_prelab*2*pi;
beta_prelab = sqrt((w_prelab/c)^2 -(m*pi/a)^2-(n*pi/b)^2);
Rs = sqrt(w_prelab*permeability_free_space/(2*conductivity));
atten_const_prelab = (2*pi^2*Rs*(b+a/2+(beta_prelab^2*a^3/(2*pi^2))))/(w_prelab*permeability_free_space*a^3*b*beta_prelab);

%%%Attenuation Constant that was measured%%%

fc_theory = 3*10^8/(2*a); %Theoretical Cutoff Frequency for TE10
wc_theory = fc_theory*2*pi;

%Operating Frequency is above cutoff frequency
idx = freq >= fc_theory;
idy = w >= wc_theory;
f = freq(idx);
w_operating = w(idy);

%Now have a range of w values, we can calculate our theoretical Beta value
%for differing values of w as we did before

beta_operating = sqrt(((w_operating./(3*10^8)).^2-(m*pi/a)^2-(n*pi/b)^2));
Rs_operating = sqrt(w_operating*permeability_free_space/(2*conductivity));

%Now we can calculate the theoretical values of the attenuation constant
%over a frequency range
atten_const_operating = (2*pi^2.*Rs_operating.*(b + a/2 + (beta_operating.^2*a^3/(2*pi^2)))) ./ (w_operating*permeability_free_space*a^3*b.*beta_operating);

%Now use our data to find the actual attenuation constant
S21_db_cutoff = S21_db(idx);

atten_const_lab    = -S21_db_cutoff ./ (8.686*L);   % Np/m
atten_const_lab_dB = -S21_db_cutoff ./ L;           % dB/m

%Plotting
figure;
plot(f./10^9, atten_const_lab, f./10^9, atten_const_operating);
grid on
legend("Measured", "Theory")
title("Attenuation Constant")
xlabel('frequency (GHz)'); ylabel("Np/m")

figure
plot(f./10^9, atten_const_operating)
title("Attenuation Constant Theory")
xlabel('frequency (GHz)'); ylabel("Np/m")

figure; 
f_mark = 7*10^9; %Prelab value
[~,k] = min(abs(f - f_mark)); 
plot(f./10^9, S21_db_cutoff); 
hold on
plot(f(k)./10^9, S21_db_cutoff(k), 'ro', 'MarkerFaceColor','r')
text(f(k)./10^9, S21_db_cutoff(k), sprintf('  f = %.2f GHz\n  S21 = %.3f dB\n  \\alpha = %.3f Np/m', ...
     f(k)/1e9, S21_db_cutoff(k), atten_const_lab(k)))
grid on
title("|S21| (dB)")
xlabel('frequency (GHz)'); ylabel('dB')

%Comparing Prelab values
err = mean(abs(atten_const_lab - atten_const_operating)./atten_const_operating)*100;
fprintf('mean attenuation constant error = %.2f %%\n', err);

err7GHz_lab  = mean(abs(atten_const_lab(k) - atten_const_prelab)./atten_const_prelab)*100;
ratio_lab = mean(atten_const_lab(k)./atten_const_prelab);

% Same comparison at 10 GHz
f_mark10 = 10*10^9;
[~,k10] = min(abs(f - f_mark10));
err10GHz_lab = abs(atten_const_lab(k10) - atten_const_operating(k10))./atten_const_operating(k10)*100;
ratio10_lab  = atten_const_lab(k10)./atten_const_operating(k10);

% Results at 7 GHz (pre-lab frequency)
fprintf('\n--- 7 GHz ---\n');
fprintf('frequency used      = %.2f GHz\n', f(k)/1e9);
fprintf('measured alpha      = %.4f Np/m\n', atten_const_lab(k));
fprintf('pre-lab alpha       = %.4f Np/m\n', atten_const_prelab);
fprintf('percent error       = %.1f %%\n', err7GHz_lab);
fprintf('ratio (meas/theory) = %.2f\n', ratio_lab);
fprintf('measured guide loss = %.3f dB, theory = %.3f dB\n', ...
        -S21_db_cutoff(k), atten_const_prelab*8.686*L);

% Results at 10 Ghz
fprintf('\n--- 10 GHz ---\n');
fprintf('frequency used      = %.2f GHz\n', f(k10)/1e9);
fprintf('measured alpha      = %.4f Np/m\n', atten_const_lab(k10));
fprintf('theory alpha        = %.4f Np/m\n', atten_const_operating(k10));
fprintf('percent error       = %.1f %%\n', err10GHz_lab);
fprintf('ratio (meas/theory) = %.2f\n', ratio10_lab);
fprintf('measured guide loss = %.3f dB, theory = %.3f dB\n', ...
        -S21_db_cutoff(k10), atten_const_operating(k10)*8.686*L);

figure;
plot(f./10^9, test1_s21_db(idx), f./10^9, test2_s21_db(idx)); grid on
yline(0, 'k--');
legend('test1 (adapters + guide)', 'test2 (adapters only)')
xlabel('frequency (GHz)'); ylabel('S21 (dB)'); ylim([-3 1])

fprintf('7 GHz:  test1 = %.3f dB, test2 = %.3f dB\n', test1_s21_db(idx(k)), test2_s21_db(idx(k)));

%% Phase Velocity
clc; clear all; close all
S1 = load('test1.s2p');
S2 = load('test2.s2p');
freq      = S1(:,1);                      % Hz
S21_phasea = S1(:,5)*pi/180;    % radians, already unwrapped to [-pi, pi]
S21_phaseb = S2(:,5)*pi/180;    % radians
phase_test1 = unwrap(S21_phasea);          % adapters + guide (raw test1), rad
w = 2*pi.*freq;
a = 22.86*10^-3;
b = 10.16*10^-3;
L = 152*10^-3;
c = 3*10^8;
m=1;
n=0;
s21_phase = unwrap(S21_phasea-S21_phaseb);

%Display unwrapped phase
figure;
plot(freq/10^9, phase_test1, freq/10^9, s21_phase); grid on
legend('adapters + guide (test1)', 'guide only (test1 - test2)')
xlabel('frequency (GHz)'); ylabel('unwrapped phase of S21 (rad)')
title('Unwrapped phase of S21')

%Plot the measured and theoretical values of vph
%Theoretical Values of vph
fc_theory = 3*10^8/(2*a); %Theoretical Cutoff Frequency for TE10
wc_theory = fc_theory*2*pi;
idx = freq >= fc_theory;
idy = w >= wc_theory;
f = freq(idx);
w_theory = w(idy);
beta_theory = sqrt((w_theory/c).^2-(m*pi/a)^2-(n*pi/b)^2);

vph_theory = w_theory./beta_theory;

%Real value of vph

%First find beta

ph = s21_phase(idx);

[~,k] = min(abs(f - 10e9));                 % fix the 2*pi offset at 10 GHz
n = round((beta_theory(k)*L + ph(k))/(2*pi));
beta_measured = (-ph + 2*pi*n)/L;                  % measured: phase = -beta*L

vph_measured = w_theory./beta_measured;

%Plot
figure
plot(f./10^9,vph_theory, f./10^9, vph_measured); grid on;
legend("Theory", "Measured")
xlabel("frequency (Ghz)"); ylabel(" m/s")
title("Phase Velocity over Frequencies");

err_vph = mean(abs(vph_measured - vph_theory)./vph_theory)*100;
ratio_vph = mean(vph_measured./vph_theory);
fprintf('mean vph error (>= cutoff) = %.2f %%\n', err_vph);
fprintf('mean ratio (meas/theory)   = %.3f\n', ratio_vph);

% vph at 10 GHz
fprintf('10 GHz: theory = %.3e m/s, measured = %.3e m/s\n', vph_theory(k), vph_measured(k));

