%% Calculate TE101 and TE102 Modes using theoretical Eqns.
%Waveguide Numbers (test for now)
a = 23e-3;                           % WR-90 broad wall
b = 10.2e-3;
d = 28.2*10^-3;
c = 3*10^8;
cond = 2.564*10^-7;
permeability_free_space = 4*pi*10^-7;
permittivity_free_space = 8.85418782 * 10^-12;

eta = sqrt(permeability_free_space/ permittivity_free_space);

fc101 = c/(2*pi)*sqrt((pi/a)^2+(0*pi/b)^2+(pi/d)^2);

fc102 = c/(2*pi)*sqrt((pi/a)^2+(0*pi/b)^2+(2*pi/d)^2);

k101 = sqrt((pi/a)^2+(0*pi/b)^2+(pi/d)^2);
k102 = sqrt((pi/a)^2+(0*pi/b)^2+(2*pi/d)^2);

Rs101 = sqrt((2*pi*fc101*4*pi*10^-7)/(2*cond));
Rs102 = sqrt((2*pi*fc102*4*pi*10^-7)/(2*cond));

Q101 = (k101*a*d)^3*b*eta/(2*pi^2*Rs101)*(1/(2*1^2*a^3*b + 2*b*d^3 + 1^2*a^3*d + a*d^3));
Q102 = (k102*a*d)^3*b*eta/(2*pi^2*Rs102)*(1/(2*2^2*a^3*b + 2*b*d^3 + 2^2*a^3*d + a*d^3));



%% Measure and plot the return loss around the resonant frequency of the dominant mode
clc; close all; 
S1 = load('port 1.s2p');                 % one-port cavity measurement
freq = S1(:,1);                         % Hz
S11_db = S1(:,2);                       % dB

a = 23e-3;                           % WR-90 broad wall
b = 10.2e-3;
d = 28.2*10^-3;
c = 3e8;

f101 = (c/2)*sqrt((1/a)^2 + (1/d)^2);   % TE101 resonant frequency, Hz

% Select measured points within +/- 0.5 GHz of f101
win = (freq >= f101 - 0.5e9) & (freq <= f101 + 0.5e9);
f_win  = freq(win);
RL_win = -S11_db(win);                  % return loss, positive dB

figure
plot(f_win/1e9, RL_win); 
grid on
xlabel('Frequency (GHz)'); ylabel('Return Loss (dB)')
title('TE101 one-port resonance')


%% Measure f0 and find the loaded Q
clc; close all; 
S1 = load('port 1.s2p');                
freq = S1(:,1);                         
S11_db = S1(:,2);                       

a = 22.86e-3;                           
b = 10.16e-3;
d = 27.3*10^-3;
c = 3e8;

f101 = (c/2)*sqrt((1/a)^2 + (1/d)^2);   

win = (freq >= f101 - 0.5e9) & (freq <= f101 + 0.5e9);
f_win  = freq(win);
RL_win = -S11_db(win); 

% Measure f0
[RL0, i0] = max(RL_win);
f0 = f_win(i0);
fprintf('f0 = %.6f GHz, RL(f0) = %.2f dB\n', f0/1e9, RL0);

%Find f1
RLf1 = -10*log10((1+10^(-RL0/10))/2);
[~, iL] = min(abs(RL_win(1:i0)   - RLf1));   % closest point left of f0
[~, iR] = min(abs(RL_win(i0:end) - RLf1));   % closest point right of f0

f1 = f_win(iL);
f2 = f_win(i0 - 1 + iR);

df = f2 - f1;
QL = f0/df;

G0 = 10^(-RL0/20);                 % |Gamma(f0)|, linear
K  = (1 - G0)/(1 + G0);            % undercoupled; use (1 + G0)/(1 - G0) if overcoupled
QU = QL*(1 + K);



fprintf('RL(f1) = %.3f dB\n', RLf1);
fprintf('f1 = %.6f GHz, f2 = %.6f GHz, df = %.3f MHz\n', f1/1e9, f2/1e9, df/1e6);
fprintf('QL = %.0f\n', QL);

fprintf('f0: measured = %.4f GHz, theory = %.4f GHz, error = %+.2f %%\n', ...
        f0/1e9, fc101/1e9, (f0 - fc101)/fc101*100);
fprintf('QL = %.0f, K = %.3f, QU = %.0f\n', QL, K, QU);
fprintf('QU: measured = %.0f, theory = %.0f, error = %+.1f %%\n', ...
        QU, Q101, (QU - Q101)/Q101*100);